# API port (host port; the container itself always listens on 8080)
PORT=8081

# Postgres credentials and database name
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pkm_tracker

# Host port mapped to the Postgres container
POSTGRES_PORT=5433

# Connection string for running the API on the host against dockerized Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5433/pkm_tracker?sslmode=disable
